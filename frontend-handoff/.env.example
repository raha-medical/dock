# إعدادات تشغيل الباك اند محلياً (قيم مثال فقط، ضع قيمك أنت)
# في PowerShell: كل سطر يصبح  $env:NAME = "value"
# الأسماء بشرطتين سفليتين __ تعني قسماً داخل appsettings.json

ConnectionStrings__Default=Host=localhost;Port=5432;Database=alrahma;Username=postgres;Password=ضع_كلمة_مرورك_هنا
Jwt__SigningKey=ضع-هنا-نصاً-عشوائياً-طويلاً-لا-يقل-عن-32-حرفاً
ASPNETCORE_URLS=http://localhost:5186
Swagger__Enabled=true

# السماح لواجهة الفرونت بالاتصال (غيّر المنفذ حسب مشروعكم)
Cors__Origins__0=http://localhost:3000
Cors__Origins__1=http://localhost:5173

# أول تشغيل فقط على قاعدة بلا مستخدمين: ينشئ الفرع الأول وحساب المدير العام
Bootstrap__AdminUsername=admin
Bootstrap__AdminPassword=Admin-Change-Me-2026

# وضع التجربة (مجاني، بلا رسائل حقيقية): رمز OTP للمريض دائماً 000000
Otp__Mode=sandbox
Otp__SandboxCode=000000
Sms__Mode=sandbox
Push__Mode=sandbox
Payments__Mode=sandbox

# اختياري: رفع الملفات يحتاج MinIO (يعمل تلقائياً مع docker compose)
Storage__ServiceUrl=http://localhost:9000
Storage__AccessKey=
Storage__SecretKey=
Storage__Bucket=medical

Jobs__Enabled=true
Backup__Enabled=false
